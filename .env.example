# Morph-Traider Environment Configuration Template
# IMPORTANT: Copy to `.env` for local development. NEVER commit real secrets.

FLASK_ENV=development
SECRET_KEY=replace-with-strong-random-secret-key-min-32-chars

# NON-NEGOTIABLE FINANCIAL SAFETY LOCKS (Phases 0-8)
TRADING_MODE=paper
ALLOW_LIVE_NOBITEX_ORDERS=false

# Database (Defaults to instance/morph_traider.db in SQLite WAL mode; supports postgresql+psycopg://...)
DATABASE_URL=

# Shared-Hosting Cron Protection
CRON_SECRET_TOKEN=replace-with-strong-cron-hmac-secret
CRON_MAX_EXECUTION_SECONDS=20

# Initial Operator Account (Optional bootstrap credentials for local/shared-host setup)
OPERATOR_USERNAME=admin
OPERATOR_PASSWORD_HASH=
